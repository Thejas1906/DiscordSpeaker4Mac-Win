DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
SINK_NAME=DiscordSpeaker
AUTO_CREATE_SINK=true
COMMAND_PREFIX=!

# Match the desktop user running PipeWire (id -u / id -g).
HOST_UID=1000
HOST_GID=1000
PULSE_RUNTIME_DIR=/run/user/1000/pulse

# --- Optional audio quality overrides (headless / Docker). Defaults are music-safe; see docs/audio-quality.md ---
# DS_OPUS_BITRATE_KBPS=0      # 0 = use the voice channel's bitrate (max 510)
# DS_BUFFER_MS=120            # jitter buffer target
# DS_OPUS_FEC=false
# DS_DITHER=true
